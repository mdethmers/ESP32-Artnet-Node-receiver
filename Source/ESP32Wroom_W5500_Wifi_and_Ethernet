// ─── Node discovery ───────────────────────────────────────────────────────────
// Runs on the lwIP tcpip task for every ArtPollReply on the wire. Must stay
// short: no Serial, no allocation, no blocking calls.
void onArtPollReply(const uint8_t *pkt, uint16_t len, uint32_t srcIp) {
  if (srcIp == 0) return;

  portENTER_CRITICAL(&nodeTableMux);

  int slot = -1;
  for (int i = 0; i < MAX_DISCOVERED_NODES; i++)
    if (discoveredNodes[i].used && discoveredNodes[i].ip == srcIp) { slot = i; break; }

  if (slot < 0)
    for (int i = 0; i < MAX_DISCOVERED_NODES; i++)
      if (!discoveredNodes[i].used) { slot = i; break; }

  if (slot < 0) {
    // Table full — reuse whichever entry we have not heard from longest
    unsigned long oldest = discoveredNodes[0].lastSeen;
    slot = 0;
    for (int i = 1; i < MAX_DISCOVERED_NODES; i++)
      if (discoveredNodes[i].lastSeen < oldest) { oldest = discoveredNodes[i].lastSeen; slot = i; }
  }

  discoveredNodes[slot].ip       = srcIp;
  discoveredNodes[slot].used     = true;
  discoveredNodes[slot].lastSeen = millis();
  memcpy(discoveredNodes[slot].name, pkt + ARTPOLLREPLY_NAME_OFF, 17);
  discoveredNodes[slot].name[17] = '\0';

  portEXIT_CRITICAL(&nodeTableMux);
}

// Copy the live entries out so the page can be rendered without holding the
// lock. Expired entries are freed on the way past.
int snapshotNodes(DiscoveredNode *out, int maxOut) {
  unsigned long now = millis();
  int n = 0;

  portENTER_CRITICAL(&nodeTableMux);
  for (int i = 0; i < MAX_DISCOVERED_NODES && n < maxOut; i++) {
    if (!discoveredNodes[i].used) continue;
    if (now - discoveredNodes[i].lastSeen > NODE_EXPIRY_MS) {
      discoveredNodes[i].used = false;
      continue;
    }
    out[n++] = discoveredNodes[i];
  }
  portEXIT_CRITICAL(&nodeTableMux);

  return n;
}

// Sort by dotted-quad order. The stored address is network byte order, so it
// has to be byte-swapped before comparing numerically on this little-endian MCU.
void sortNodesByIP(DiscoveredNode *list, int count) {
  for (int i = 1; i < count; i++) {
    DiscoveredNode key = list[i];
    int j = i - 1;
    while (j >= 0 && __builtin_bswap32(list[j].ip) > __builtin_bswap32(key.ip)) {
      list[j + 1] = list[j];
      j--;
    }
    list[j + 1] = key;
  }
}

// Node names arrive over the network, so they are escaped before going into
// the page. Non-printable bytes are dropped rather than rendered.
String htmlEscape(const char *s) {
  String out;
  for (const char *p = s; *p; p++) {
    if (*p < 32 || *p > 126) continue;
    switch (*p) {
      case '&':  out += F("&amp;");  break;
      case '<':  out += F("&lt;");   break;
      case '>':  out += F("&gt;");   break;
      case '"':  out += F("&quot;"); break;
      case '\'': out += F("&#39;");  break;
      default:   out += *p;          break;
    }
  }
  return out;
}

// Same job as htmlEscape but for locally-set strings (node name, SSID,
// password) that go back into an input's value. Non-ASCII is kept, so a UTF-8
// passphrase survives a round trip through the form instead of being silently
// mangled on the next save.
String attrEscape(const String& s) {
  String out;
  out.reserve(s.length() + 8);
  for (unsigned int i = 0; i < s.length(); i++) {
    char c = s[i];
    switch (c) {
      case '&':  out += F("&amp;");  break;
      case '<':  out += F("&lt;");   break;
      case '>':  out += F("&gt;");   break;
      case '"':  out += F("&quot;"); break;
      case '\'': out += F("&#39;");  break;
      default:   out += c;           break;
    }
  }
  return out;
}

// Node names arrive over the network, so the /nodes JSON gets the same
// printable-ASCII-only treatment as the HTML path.
String jsonEscape(const char *s) {
  String out;
  for (const char *p = s; *p; p++) {
    if (*p < 32 || *p > 126) continue;
    if (*p == '"' || *p == '\\') out += '\\';
    out += *p;
  }
  return out;
}

