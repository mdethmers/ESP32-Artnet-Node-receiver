// ─── Status LED ───────────────────────────────────────────────────────────────
void setStatusLED(uint8_t r, uint8_t g, uint8_t b) {
  StatusLed.setPixelColor(0, StatusLed.Color(r/2, g/2, b/2));
  StatusLed.show();
}

// ─── Colour cycle (test mode) ─────────────────────────────────────────────────
void cycleLEDs() {
  if (millis() - state.lastUpdate < CYCLE_DELAY) return;
  state.lastUpdate = millis();

  int channels = getChannelsPerLed();
  uint8_t r = 0, g = 0, b = 0, w1 = 0, w2 = 0;
  switch (state.currentColor) {
    case 0: r  = settings.ledBrightness; break;
    case 1: g  = settings.ledBrightness; break;
    case 2: b  = settings.ledBrightness; break;
    case 3: if (channels >= 4) w1 = settings.ledBrightness; break;
    case 4: if (channels >= 5) w2 = settings.ledBrightness; break;
  }
  state.currentColor = (state.currentColor + 1) % channels;
  setAllLeds(r, g, b, w1, w2);
}

// ─── Static colour ────────────────────────────────────────────────────────────
void applyStaticColor() {
  if (!settings.enStatColor) return;
  uint32_t color = strtol(settings.staticColor.substring(1).c_str(), NULL, 16);
  uint8_t r = (color >> 16) & 0xFF;
  uint8_t g = (color >>  8) & 0xFF;
  uint8_t b =  color        & 0xFF;
  setStatusLED(r, g, b);

  if (settings.ledType == LED_TYPE_WS2812) {
    if (settings.channelMode == CHANNEL_MODE_RGBWW) {
      int total = settings.numOutputs * settings.numLedsPerOutput;
      memset(ledData, 0, sizeof(ledData));
      for (int i = 0; i < total; i++) {
        ledData[i * 5 + 0] = r;
        ledData[i * 5 + 1] = g;
        ledData[i * 5 + 2] = b;
        ledData[i * 5 + 3] = settings.whiteLevel;
        ledData[i * 5 + 4] = settings.white2Level;
      }
      driver.showPixels(NO_WAIT, ledData);

    } else if (settings.channelMode == CHANNEL_MODE_RGBW) {
      for (int i = 0; i < settings.numOutputs; i++) {
        for (int j = 0; j < settings.numLedsPerOutput; j++) {
          strips[i].setPixelColor(j, r, g, b, settings.whiteLevel);
        }
        strips[i].show();
      }

    } else {
      setAllLeds(r, g, b);
    }

  } else {
    setAllLeds(r, g, b);
  }
}

// ─── Colour selection (boot-button standalone mode) ───────────────────────────
void handleColorSelection() {
  if (millis() - state.lastBlinkTime >= 500) {
    state.lastBlinkTime = millis();
    state.displayBlink  = !state.displayBlink;
    if (state.displayBlink)
      displayStatus("Color Selection", "Color: " + presetColors[state.selectedColorIndex]);
    else
      displayStatus("", "");
  }
  uint32_t color = strtol(presetColors[state.selectedColorIndex].substring(1).c_str(), NULL, 16);
  uint8_t r = (color >> 16) & 0xFF;
  uint8_t g = (color >>  8) & 0xFF;
  uint8_t b =  color        & 0xFF;
  setStatusLED(r, g, b);
  setAllLeds(r, g, b);
}

// ─── Boot button ──────────────────────────────────────────────────────────────
void checkBootButton() {
  if (digitalRead(BOOT_BUTTON_PIN) != LOW) return;
  unsigned long pressTime = millis();

  while (digitalRead(BOOT_BUTTON_PIN) == LOW) {
    unsigned long dur = millis() - pressTime;
    if (dur > 1000) {
      // Long press
      if (settings.networkMode == 0) {
        settings.useStaticIP = !settings.useStaticIP;
        saveSettings();
        displayStatus("Switching to", settings.useStaticIP ? "Static IP" : "DHCP",
                      settings.useStaticIP ? settings.staticIP : "");
        while (digitalRead(BOOT_BUTTON_PIN) == LOW) delay(10);
        delay(1000); ESP.restart(); return;
      } else if (settings.networkMode == 4) {
        state.colorSelectionMode = !state.colorSelectionMode;
        if (state.colorSelectionMode) {
          for (int i = 0; i < PRESET_COLORS_COUNT; i++) {
            if (settings.staticColor == presetColors[i]) { state.selectedColorIndex = i; break; }
          }
          state.lastBlinkTime = millis();
          state.displayBlink  = true;
          displayStatus("Color Selection", "Color: " + presetColors[state.selectedColorIndex]);
        } else {
          settings.staticColor  = presetColors[state.selectedColorIndex];
          saveSettings();
          state.isStaticColorSet = false;
          state.displayBlink     = false;
          displayStatus("Static Color Mode", "Color: " + settings.staticColor, "Press button to exit");
        }
        while (digitalRead(BOOT_BUTTON_PIN) == LOW) delay(10);
        return;
      } else if (settings.networkMode == 3) {
        settings.randomFadeEnabled = !settings.randomFadeEnabled;
        saveSettings();
        displayStatus("RGB Test Mode", settings.randomFadeEnabled ? "Random Fade" : "RGB Cycle", "Long press to toggle");
        while (digitalRead(BOOT_BUTTON_PIN) == LOW) delay(10);
        return;
      } else {
        break;
      }
    }
    delay(10);
  }

  unsigned long dur = millis() - pressTime;
  if (dur > 100) {
    if (settings.networkMode == 4 && state.colorSelectionMode) {
      state.selectedColorIndex = (state.selectedColorIndex + 1) % PRESET_COLORS_COUNT;
      state.isStaticColorSet   = false;
    } else {
      settings.networkMode = (settings.networkMode + 1) % 5;
      switch (settings.networkMode) {
        case 0: settings.useWiFi=false; settings.ledCycleEnabled=false; settings.enStatColor=false; displayStatus("Switching Mode...","Ethernet"); break;
        case 1: settings.useWiFi=true;  settings.ledCycleEnabled=false; settings.enStatColor=false; displayStatus("Switching Mode...","Wi-Fi");    break;
        case 2: settings.useWiFi=false; settings.ledCycleEnabled=false; settings.enStatColor=false; displayStatus("Switching Mode...","AP Mode");   break;
        case 3: settings.ledCycleEnabled=true;  settings.enStatColor=false; displayStatus("Switching Mode...","RGB Test Cycle"); break;
        case 4: settings.ledCycleEnabled=false; settings.enStatColor=true;  displayStatus("Switching Mode...","Static Color");   break;
      }
      saveSettings(); delay(1000); ESP.restart();
    }
  }
}

// ─── Static IP resolution ─────────────────────────────────────────────────────
// Only the IP itself is mandatory. A blank or malformed subnet is filled in
// from the address class, and a blank gateway means "no default route", which
// is normal on an isolated lighting network.

// A netmask must be a contiguous run of 1-bits. /0 and /32 are unusable here.
static bool isValidSubnet(IPAddress sn) {
  uint32_t m = ((uint32_t)sn[0] << 24) | ((uint32_t)sn[1] << 16) |
               ((uint32_t)sn[2] <<  8) |  (uint32_t)sn[3];
  if (m == 0 || m == 0xFFFFFFFFUL) return false;
  uint32_t inv = ~m;
  return (inv & (inv + 1)) == 0;
}

// ArtNet networks conventionally sit on 2.x.x.x / 10.x.x.x with a /8 mask.
static IPAddress defaultSubnetFor(IPAddress ip) {
  if (ip[0] == 2 || ip[0] == 10) return IPAddress(255, 0, 0, 0);
  return IPAddress(255, 255, 255, 0);
}

static bool sameSubnet(IPAddress a, IPAddress b, IPAddress mask) {
  for (int i = 0; i < 4; i++)
    if ((a[i] & mask[i]) != (b[i] & mask[i])) return false;
  return true;
}

NetConfig resolveStaticConfig() {
  NetConfig cfg;
  String ipStr = settings.staticIP; ipStr.trim();
  String gwStr = settings.gateway;  gwStr.trim();
  String snStr = settings.subnet;   snStr.trim();

  if (!cfg.ip.fromString(ipStr) || (uint32_t)cfg.ip == 0) {
    Serial.println("Static IP is blank or malformed — using DHCP instead");
    return cfg;
  }

  if (!cfg.subnet.fromString(snStr) || !isValidSubnet(cfg.subnet)) {
    cfg.subnet = defaultSubnetFor(cfg.ip);
    Serial.println("Subnet blank or invalid — defaulting to " + cfg.subnet.toString());
  }

  if (!cfg.gateway.fromString(gwStr)) cfg.gateway = IPAddress(0, 0, 0, 0);

  // A gateway outside our own subnet is unreachable — better no default route
  // than a broken one that black-holes traffic.
  if ((uint32_t)cfg.gateway != 0 && !sameSubnet(cfg.ip, cfg.gateway, cfg.subnet)) {
    Serial.println("Gateway " + cfg.gateway.toString() + " is outside the subnet — ignoring it");
    cfg.gateway = IPAddress(0, 0, 0, 0);
  }

  cfg.valid = true;
  return cfg;
}

// ─── WiFi setup ───────────────────────────────────────────────────────────────
void setupWiFi() {
  if (settings.useStaticIP) {
    NetConfig net = resolveStaticConfig();
    if (net.valid) {
      if (!WiFi.config(net.ip, net.gateway, net.subnet))
        Serial.println("WiFi.config() rejected the static address — using DHCP");
    } else {
      displayStatus("Static IP invalid", "Falling back to DHCP");
    }
  }
  WiFi.begin(settings.ssid.c_str(), settings.password.c_str());
  displayStatus("Connecting to Wi-Fi...");
  while (WiFi.status() != WL_CONNECTED) {
    checkBootButton();
    state.ledState = !state.ledState;
    setStatusLED(state.ledState ? 255 : 0, 0, 0);
    displayConnectionStatus("Wi-Fi");
    delay(500);
  }
  registerRoutes();
  server.begin();
  displayStatus("Wi-Fi connected", settings.ssid);
  setStatusLED(0, 255, 0);
}

// ─── Ethernet setup ───────────────────────────────────────────────────────────
void setupEthernet() {
  displayStatus("Initializing Ethernet");
  ESP32_W5500_onEvent();
  ETH.begin(MISO_GPIO, MOSI_GPIO, SCK_GPIO, CS_GPIO, INT_GPIO, SPI_CLOCK_MHZ, ETH_SPI_HOST);
  if (settings.useStaticIP) {
    NetConfig net = resolveStaticConfig();
    if (net.valid) {
      if (!ETH.config(net.ip, net.gateway, net.subnet))
        Serial.println("ETH.config() rejected the static address — using DHCP");
    } else {
      displayStatus("Static IP invalid", "Falling back to DHCP");
    }
  }

  // A static address is live immediately, so this only spins in DHCP mode.
  // Waiting indefinitely is deliberate: the node comes up whenever the network
  // does, rather than inventing an address of its own.
  while (ETH.localIP() == INADDR_NONE) {
    checkBootButton();
    state.ledState = !state.ledState;
    setStatusLED(state.ledState ? 255 : 0, 0, 0);
    displayConnectionStatus("Ethernet");
    delay(500);
  }
  registerRoutes();
  server.begin();
  Serial.println("Ethernet setup complete");
}

// ─── AP mode ──────────────────────────────────────────────────────────────────
void startAPMode() {
  state.isAPMode = true;
  WiFi.softAP(settings.nodeName.c_str());
  IPAddress IP = WiFi.softAPIP();
  registerRoutes();
  server.begin();
  setStatusLED(0, 0, 255);
  displayStatus("AP Mode", settings.nodeName, "IP:" + IP.toString());
}

// ─── Asset + API routes ───────────────────────────────────────────────────────
// CSS and JS live on their own cached routes (see webassets.h) instead of being
// inlined into every page. The config page then fits comfortably in one String,
// and a reload costs a few kB of markup rather than the whole UI.
void handleStyle() {
  server.sendHeader(F("Cache-Control"), F("max-age=604800"));
  server.send_P(200, "text/css;charset=utf-8", CSS_STYLES);
}

void handleScript() {
  server.sendHeader(F("Cache-Control"), F("max-age=604800"));
  server.send_P(200, "application/javascript;charset=utf-8", JS_CODE);
}

// The refresh button asks for ?poll=1, which puts an ArtPoll on the wire before
// answering. Replies land a few hundred ms later, so the page fetches once more
// after a short wait to pick them up.
void handleNodes() {
  if (server.hasArg("poll")) artnet.sendArtPoll();

  DiscoveredNode nodes[MAX_DISCOVERED_NODES];
  int count = snapshotNodes(nodes, MAX_DISCOVERED_NODES);
  sortNodesByIP(nodes, count);

  IPAddress      selfIP  = currentIP();
  uint32_t       selfRaw = (uint32_t)selfIP;
  unsigned long  now     = millis();

  String out;
  out.reserve(120 + count * 72);
  out += F("{\"self\":{\"n\":\"");
  out += jsonEscape(settings.nodeName.c_str());
  out += F("\",\"ip\":\"");
  out += selfIP.toString();
  out += F("\"},\"nodes\":[");

  bool first = true;
  for (int i = 0; i < count; i++) {
    if (nodes[i].ip == selfRaw) continue;      // never list ourselves twice
    if (!first) out += ',';
    first = false;
    out += F("{\"n\":\"");
    out += jsonEscape(nodes[i].name);
    out += F("\",\"ip\":\"");
    out += IPAddress(nodes[i].ip).toString();
    out += F("\",\"a\":");
    out += String((now - nodes[i].lastSeen) / 1000);
    out += '}';
  }
  out += F("]}");

  server.sendHeader(F("Cache-Control"), F("no-store"));
  server.send(200, "application/json", out);
}

void registerRoutes() {
  server.on("/",          HTTP_GET,  handleRoot);
  server.on("/config",    HTTP_POST, handleConfig);
  server.on("/update",    HTTP_GET,  handleOTAUpdate);
  server.on("/doUpdate",  HTTP_POST, handleOTAUpdateResponse, handleDoUpdate);
  server.on("/style.css", HTTP_GET,  handleStyle);
  server.on("/app.js",    HTTP_GET,  handleScript);
  server.on("/nodes",     HTTP_GET,  handleNodes);
}

// ─── Page building blocks ─────────────────────────────────────────────────────
// Every control on the page goes through one of these, which is what keeps the
// layout uniform: one row shape, one toggle, one segmented control.

static void pageHead(String& c, const String& title) {
  c += F("<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>"
         "<meta name='viewport' content='width=device-width,initial-scale=1'>"
         "<meta name='color-scheme' content='light dark'>"
         "<link rel='icon' href='data:,'><title>");
  c += attrEscape(title);
  c += F("</title><link rel='stylesheet' href='/style.css?v=" ASSET_VER "'>"
         "<script>try{var t=localStorage.getItem('theme');"
         "if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>"
         "</head><body><div class='shell'>");
}

static void tipButton(String& c, const __FlashStringHelper* tip) {
  c += F("<button type='button' class='tip' aria-label='What is this?' data-tip=\"");
  c += tip;
  c += F("\">i</button>");
}

// Opens a row and writes its label cell. The caller writes the control, then
// closes with rowEnd().
static void rowStart(String& c, const __FlashStringHelper* label,
                     const __FlashStringHelper* tip,
                     const char* forId = nullptr, const char* rowId = nullptr) {
  c += F("<div class='row'");
  if (rowId) { c += F(" id='"); c += rowId; c += F("'"); }
  c += F("><span class='lbl'>");
  if (forId) { c += F("<label for='"); c += forId; c += F("'>"); }
  c += label;
  if (forId) c += F("</label>");
  if (tip) tipButton(c, tip);
  c += F("</span>");
}
static void rowEnd(String& c) { c += F("</div>"); }

static void segOption(String& c, const char* name, const char* id,
                      int value, bool on, const __FlashStringHelper* label) {
  c += F("<input type='radio' name='"); c += name;
  c += F("' id='");   c += id;
  c += F("' value='"); c += String(value);
  c += on ? F("' checked>") : F("'>");
  c += F("<label for='"); c += id; c += F("'>"); c += label; c += F("</label>");
}

static void toggleSwitch(String& c, const char* name, const char* id, bool on) {
  c += F("<label class='sw'><input type='checkbox' name='"); c += name;
  c += F("' id='"); c += id;
  c += on ? F("' checked>") : F("'>");
  c += F("<i></i></label>");
}

static void slider(String& c, const char* name, const char* id, int lo, int hi,
                   int value, const char* outId, const String& outText,
                   bool wideOut = false) {
  // A nameless slider drives a hidden field instead of posting its own value —
  // that is how the universe and output sliders work.
  c += F("<div class='meter'><input type='range'");
  if (name) { c += F(" name='"); c += name; c += F("'"); }
  c += F(" id='");  c += id;
  c += F("' min='"); c += String(lo);
  c += F("' max='"); c += String(hi);
  c += F("' value='"); c += String(value);
  c += F("'><output id='"); c += outId;
  c += wideOut ? F("' class='wide'>") : F("'>");
  c += outText;
  c += F("</output></div>");
}
// ─── Web root page ────────────────────────────────────────────────────────────
// Reading order is setup order: find your node, name it and put it on the
// network, patch it, describe the hardware, then say what it should output.
// Anything a first-time setup does not need is behind a disclosure or only
// appears once the switch above it is on.
void handleRoot() {
  IPAddress ip   = currentIP();
  int       lpuv = getLedsPerUniverse();
  int       upo  = max(1, min(4, (settings.numLedsPerOutput + lpuv - 1) / lpuv));

  String c;
  c.reserve(12000);
  pageHead(c, settings.nodeName);

  // ── Masthead: who am I, where am I, what am I speaking ────────────────────
  c += F("<header class='masthead'><span class='dot");
  if (state.isAPMode) c += F(" ap");
  c += F("'></span><div class='id'><h1>");
  c += attrEscape(settings.nodeName);
  c += F("</h1><p class='readout'>");
  c += ip.toString();
  c += F(" &middot; ");
  c += state.isAPMode           ? F("Access point")
     : (settings.networkMode == 1) ? F("Wi-Fi")
                                   : F("Ethernet");
  c += F(" &middot; ");
  c += (settings.protocolMode == PROTOCOL_ARTNET) ? F("Art-Net")
     : (settings.protocolMode == PROTOCOL_SACN)   ? F("sACN")
                                                  : F("Art-Net + sACN");
  c += F("</p></div>"
         "<button type='button' id='theme' class='icon lg' aria-label='Switch theme'></button>"
         "</header>");

  // ── Nodes on this network ─────────────────────────────────────────────────
  // Outside the form, so picking a node never posts anything.
  {
    DiscoveredNode nodes[MAX_DISCOVERED_NODES];
    int           count   = snapshotNodes(nodes, MAX_DISCOVERED_NODES);
    sortNodesByIP(nodes, count);
    uint32_t      selfRaw = (uint32_t)ip;
    unsigned long now     = millis();

    c += F("<section class='panel'><div class='legend'>Nodes on this network");
    tipButton(c, F("Every node that answered an Art-Net poll in the last 15 seconds. "
                   "Refresh polls the network again; replies take a moment to arrive."));
    c += F("<button type='button' id='reload' class='icon' "
           "aria-label='Refresh the node list'></button></div>"
           "<ul class='nodes' id='nodes'><li class='here'><span class='nm'>");
    c += attrEscape(settings.nodeName);
    c += F("</span><span class='ip'>");
    c += ip.toString();
    c += F("</span><span class='tag'>This node</span></li>");

    int others = 0;
    for (int i = 0; i < count; i++) {
      if (nodes[i].ip == selfRaw) continue;   // never list ourselves twice
      String ipStr = IPAddress(nodes[i].ip).toString();
      String name  = htmlEscape(nodes[i].name);
      c += F("<li><a class='nm' href='http://");
      c += ipStr;
      c += F("/'>");
      c += name.length() ? name : String(F("Unnamed node"));
      c += F("</a><span class='ip'>");
      c += ipStr;
      c += F("</span><span class='ip'>");
      c += String((now - nodes[i].lastSeen) / 1000);
      c += F("s ago</span></li>");
      others++;
    }

    c += F("</ul><p class='foot' id='nodecount'>");
    if (others == 0) {
      c += F("No other Art-Net nodes have answered. Refresh to poll the network again.");
    } else {
      c += String(others);
      c += (others == 1) ? F(" other node is") : F(" other nodes are");
      c += F(" answering polls. Select one to open its configuration.");
    }
    c += F("</p></section>");
  }

  c += F("<form id='cfg' method='POST' action='/config'>");

  // ── Node ──────────────────────────────────────────────────────────────────
  c += F("<section class='panel'><div class='legend'>Node</div>");

  rowStart(c, F("Name"),
           F("Shown in your console's node list and in Art-Net poll replies. "
             "Keep it under 18 characters — longer names are cut short on the wire."),
           "nodename");
  c += F("<input type='text' id='nodename' name='nodename' maxlength='17' value='");
  c += attrEscape(settings.nodeName);
  c += F("'>");
  rowEnd(c);

  rowStart(c, F("Link"),
           F("Ethernet is the safe choice for anything past a test rig. Wi-Fi starts "
             "dropping frames as the pixel count climbs."));
  c += F("<div class='seg'>");
  segOption(c, "link", "ln0", 0, !settings.useWiFi, F("Ethernet"));
  segOption(c, "link", "ln1", 1,  settings.useWiFi, F("Wi-Fi"));
  c += F("</div>");
  rowEnd(c);

  c += F("<div id='wifiRows'>");
  rowStart(c, F("Wi-Fi network"), nullptr, "ssid");
  c += F("<input type='text' id='ssid' name='ssid' value='");
  c += attrEscape(settings.ssid);
  c += F("'>");
  rowEnd(c);

  rowStart(c, F("Password"), nullptr, "password");
  c += F("<div class='meter'><input type='password' id='password' name='password' value='");
  c += attrEscape(settings.password);
  c += F("'><button type='button' id='pwshow' class='btn link'>Show</button></div>");
  rowEnd(c);
  c += F("</div>");

  rowStart(c, F("Fixed address"),
           F("Give the node an address that never moves, so the patch in your console "
             "keeps pointing at it. Leave off to take DHCP."),
           "useStaticIP");
  toggleSwitch(c, "useStaticIP", "useStaticIP", settings.useStaticIP);
  rowEnd(c);

  c += F("<div id='ipRows'>");
  rowStart(c, F("IP address"), nullptr, "staticIP");
  c += F("<input type='text' class='mono' id='staticIP' name='staticIP' "
         "placeholder='192.168.1.100' value='");
  c += attrEscape(settings.staticIP);
  c += F("'>");
  rowEnd(c);

  rowStart(c, F("Subnet mask"),
           F("Optional. Left blank, the node takes a mask from the address itself — "
             "/8 on a 2.x or 10.x lighting network, /24 anywhere else."),
           "subnet");
  c += F("<input type='text' class='mono' id='subnet' name='subnet' "
         "placeholder='Automatic' value='");
  c += attrEscape(settings.subnet);
  c += F("'>");
  rowEnd(c);

  rowStart(c, F("Gateway"),
           F("Optional. Leave blank on an isolated lighting network. A gateway outside "
             "the subnet is dropped rather than black-holing traffic."),
           "gateway");
  c += F("<input type='text' class='mono' id='gateway' name='gateway' "
         "placeholder='None' value='");
  c += attrEscape(settings.gateway);
  c += F("'>");
  rowEnd(c);
  c += F("</div></section>");

  // ── Patch ─────────────────────────────────────────────────────────────────
  c += F("<section class='panel'><div class='legend'>Patch</div>");

  rowStart(c, F("Protocol"),
           F("Art-Net and sACN can run side by side. Pick what your console sends, "
             "or leave both on if you are not sure."));
  c += F("<div class='seg'>");
  segOption(c, "protocolMode", "pm0", 0, settings.protocolMode == PROTOCOL_ARTNET, F("Art-Net"));
  segOption(c, "protocolMode", "pm1", 1, settings.protocolMode == PROTOCOL_SACN,   F("sACN"));
  segOption(c, "protocolMode", "pm2", 2, settings.protocolMode == PROTOCOL_BOTH,   F("Both"));
  c += F("</div>");
  rowEnd(c);

  int shownUniverse = (settings.protocolMode == PROTOCOL_SACN) ? settings.startUniverse + 1
                                                               : settings.startUniverse;
  rowStart(c, F("First universe"),
           F("The universe output 1 listens on. The remaining outputs take the "
             "universes that follow it, in order."),
           "uniStart");
  c += F("<input type='text' class='mono' id='uniStart' inputmode='numeric' value='");
  c += String(shownUniverse);
  c += F("'><input type='hidden' id='startuniverse' name='startuniverse' value='");
  c += String(settings.startUniverse);
  c += F("'><p class='hint' id='uniHint'></p>");
  rowEnd(c);

  rowStart(c, F("Universes per output"),
           F("One universe carries 170 pixels in RGB, 128 in RGBW or 102 in RGBWW. "
             "Outputs always begin on a universe boundary, so this is set in whole "
             "universes."),
           "uniSlider");
  slider(c, nullptr, "uniSlider", 1, 4, upo, "uniVal", String(), true);
  c += F("<input type='hidden' id='numledsoutput' name='numledsoutput' value='");
  c += String(settings.numLedsPerOutput);
  c += F("'>");
  rowEnd(c);

  rowStart(c, F("Outputs in use"),
           F("How many data lines drive strips. Outputs you leave out stay dark and "
             "consume no universes."),
           "outSlider");
  slider(c, nullptr, "outSlider", 1, 4, settings.numOutputs, "outVal",
         String(settings.numOutputs));
  c += F("<input type='hidden' id='numoutput' name='numoutput' value='");
  c += String(settings.numOutputs);
  c += F("'>");
  rowEnd(c);

  // The universe map: exactly which universes each output will listen on,
  // redrawn as the sliders move. It is the one thing worth getting right
  // before saving.
  c += F("<div class='patch'><p class='patchhead'>Universe map</p>"
         "<div class='strip' id='strip'></div>"
         "<p class='tally' id='tally'></p></div></section>");

  // ── Hardware ──────────────────────────────────────────────────────────────
  c += F("<section class='panel'><div class='legend'>Hardware</div>");

  rowStart(c, F("Strip type"),
           F("WS2812 and its relatives need one data line per output. APA102 adds a "
             "clock line that every output shares."));
  c += F("<div class='seg'>");
  segOption(c, "ledType", "lt0", 0, settings.ledType == LED_TYPE_WS2812, F("WS2812"));
  segOption(c, "ledType", "lt1", 1, settings.ledType == LED_TYPE_APA102, F("APA102"));
  c += F("</div><p class='hint' id='apaNote'>APA102 shares a clock on GPIO ");
  c += String(APA102_CLOCK_PIN);
  c += F(" and always runs RGB. Data pins are set below.</p>");
  rowEnd(c);

  rowStart(c, F("Channels per pixel"),
           F("Must match the fixture profile in your console. RGBW and RGBWW pixels "
             "carry extra white channels after blue."),
           nullptr, "chRow");
  c += F("<div class='seg'>");
  segOption(c, "channelMode", "cm0", 0, settings.channelMode == CHANNEL_MODE_RGB,   F("RGB"));
  segOption(c, "channelMode", "cm1", 1, settings.channelMode == CHANNEL_MODE_RGBW,  F("RGBW"));
  segOption(c, "channelMode", "cm2", 2, settings.channelMode == CHANNEL_MODE_RGBWW, F("RGBWW"));
  c += F("</div>");
  rowEnd(c);

  rowStart(c, F("Brightness ceiling"),
           F("Applied after DMX, so your console still controls levels below it. "
             "Use it to cap power draw."),
           "ledbrightness");
  slider(c, "ledbrightness", "ledbrightness", 0, 255, settings.ledBrightness, "brVal",
         String(settings.ledBrightness));
  rowEnd(c);

  c += F("<details><summary>Data pins");
  tipButton(c, F("Change these only if your board wires the outputs differently. "
                 "The defaults match the standard build."));
  c += F("</summary>");
  rowStart(c, F("Use custom pins"), nullptr, "enableCustomPins");
  toggleSwitch(c, "enableCustomPins", "enableCustomPins", settings.enableCustomPins);
  rowEnd(c);
  c += F("<div class='pins' id='pinRows'>");
  for (int i = 0; i < NUMSTRIPS; i++) {
    c += F("<div class='pin'><span>Out ");
    c += String(i + 1);
    c += F("</span><input type='number' name='pin");
    c += String(i);
    c += F("' min='0' max='39' value='");
    c += String(settings.pins[i]);
    c += F("'><span>def ");
    c += String(DEFAULT_PINS[i]);
    c += F("</span></div>");
  }
  c += F("</div></details></section>");

  // ── Output ────────────────────────────────────────────────────────────────
  // One choice instead of three checkboxes that used to override each other.
  int outMode = settings.randomFadeEnabled ? 3
              : settings.ledCycleEnabled   ? 2
              : settings.enStatColor       ? 1 : 0;

  c += F("<section class='panel'><div class='legend'>Output</div>");
  rowStart(c, F("What the strips show"),
           F("Static colour, RGB test and fade all override incoming DMX. "
             "Set Live DMX when the rig is running."));
  c += F("<div class='seg'>");
  segOption(c, "outputMode", "om0", 0, outMode == 0, F("Live DMX"));
  segOption(c, "outputMode", "om1", 1, outMode == 1, F("Static"));
  segOption(c, "outputMode", "om2", 2, outMode == 2, F("RGB test"));
  segOption(c, "outputMode", "om3", 3, outMode == 3, F("Fade"));
  c += F("</div><p class='hint' id='modeNote'></p>");
  rowEnd(c);

  rowStart(c, F("Colour"), nullptr, "staticColor", "colorRow");
  c += F("<input type='color' id='staticColor' name='staticColor' value='");
  // Stored without a leading # on a factory-fresh node; the colour input needs one.
  if (!settings.staticColor.startsWith("#")) c += '#';
  c += attrEscape(settings.staticColor);
  c += F("'>");
  rowEnd(c);

  rowStart(c, F("White level"),
           F("Level held on the first white channel while a static colour is showing."),
           "whiteLevel", "w1Row");
  slider(c, "whiteLevel", "whiteLevel", 0, 255, settings.whiteLevel, "w1Val",
         String(settings.whiteLevel));
  rowEnd(c);

  rowStart(c, F("Second white"),
           F("Level held on the second white channel of RGBWW / CCT pixels."),
           "white2Level", "w2Row");
  slider(c, "white2Level", "white2Level", 0, 255, settings.white2Level, "w2Val",
         String(settings.white2Level));
  rowEnd(c);
  c += F("</section>");

  c += F("<div class='dock'><p class='note'>Saving restarts the node. Outputs go dark "
         "for a few seconds.</p>"
         "<input type='submit' id='save' class='btn go' value='Save &amp; restart'></div>"
         "</form>");

  c += F("<div class='pagefoot'><span>Match the pixel count and universes here to the "
         "patch in your console.</span>"
         "<a class='btn link' href='/update'>Firmware update</a></div>");

  c += F("</div><script src='/app.js?v=" ASSET_VER "' defer></script></body></html>");
  server.send(200, "text/html", c);
}

// ─── Config POST handler ──────────────────────────────────────────────────────
void handleConfig() {
  if (server.method() != HTTP_POST) return;
  if (server.hasArg("protocolMode"))  settings.protocolMode     = server.arg("protocolMode").toInt();
  if (server.hasArg("numledsoutput")) settings.numLedsPerOutput = server.arg("numledsoutput").toInt();
  if (server.hasArg("numoutput"))     settings.numOutputs       = server.arg("numoutput").toInt();
  if (server.hasArg("startuniverse"))  settings.startUniverse   = server.arg("startuniverse").toInt();
  if (server.hasArg("nodename"))      settings.nodeName         = server.arg("nodename");
  if (server.hasArg("ledbrightness")) settings.ledBrightness    = server.arg("ledbrightness").toInt();
  if (server.hasArg("ssid"))          settings.ssid             = server.arg("ssid");
  if (server.hasArg("password"))      settings.password         = server.arg("password");
  if (server.hasArg("staticColor"))   settings.staticColor      = server.arg("staticColor");
  if (server.hasArg("whiteLevel"))    settings.whiteLevel       = server.arg("whiteLevel").toInt();
  if (server.hasArg("white2Level"))   settings.white2Level      = server.arg("white2Level").toInt();

  // LED type
  if (server.hasArg("ledType"))
    settings.ledType = server.arg("ledType").toInt();

  // Channel mode (only meaningful for WS2812)
  if (settings.ledType == LED_TYPE_APA102) {
    settings.channelMode = CHANNEL_MODE_RGB;
  } else if (server.hasArg("channelMode")) {
    int newMode = server.arg("channelMode").toInt();
    if (newMode < CHANNEL_MODE_RGB || newMode > CHANNEL_MODE_RGBWW) newMode = CHANNEL_MODE_RGB;
    if (settings.channelMode != newMode) {
      settings.channelMode = newMode;
      int maxLeds = getMaxLedsPerStrip();
      if (settings.numLedsPerOutput > maxLeds) settings.numLedsPerOutput = maxLeds;
    }
  }

  // Interface. The page posts "link" (0 = Ethernet, 1 = Wi-Fi); the older
  // "useWiFi" checkbox is still honoured so an existing bookmark keeps working.
  if (server.hasArg("link")) settings.useWiFi = (server.arg("link").toInt() == 1);
  else                       settings.useWiFi = server.hasArg("useWiFi");
  settings.networkMode = settings.useWiFi ? 1 : 0;

  // What the strips show. The three flags used to be independent checkboxes
  // that overrode each other; the page now posts one exclusive choice.
  if (server.hasArg("outputMode")) {
    int m = server.arg("outputMode").toInt();
    settings.enStatColor       = (m == 1);
    settings.ledCycleEnabled   = (m == 2);
    settings.randomFadeEnabled = (m == 3);
  } else {
    settings.enStatColor       = server.hasArg("enStatColor");
    settings.ledCycleEnabled   = server.hasArg("ledCycleEnabled");
    settings.randomFadeEnabled = server.hasArg("randomFadeEnabled");
  }

  bool wasCustom = settings.enableCustomPins;
  settings.enableCustomPins = server.hasArg("enableCustomPins");
  settings.useStaticIP      = server.hasArg("useStaticIP");
  if (server.hasArg("staticIP")) { settings.staticIP = server.arg("staticIP"); settings.staticIP.trim(); }
  if (server.hasArg("gateway"))  { settings.gateway  = server.arg("gateway");  settings.gateway.trim();  }
  if (server.hasArg("subnet"))   { settings.subnet   = server.arg("subnet");   settings.subnet.trim();   }

  // Normalise before saving so what lands in NVS is what the node will
  // actually use, and the config page shows the resolved values back.
  if (settings.useStaticIP) {
    NetConfig net = resolveStaticConfig();
    if (net.valid) {
      settings.staticIP = net.ip.toString();
      settings.subnet   = net.subnet.toString();
      settings.gateway  = ((uint32_t)net.gateway != 0) ? net.gateway.toString() : "";
    } else {
      settings.useStaticIP = false;   // unusable address — don't strand the node
    }
  }

  bool pinsChanged = false;
  if (wasCustom && !settings.enableCustomPins) { resetToDefaultPins(); pinsChanged = true; }
  if (settings.enableCustomPins) {
    for (int i = 0; i < NUMSTRIPS; i++) {
      String key = "pin" + String(i);
      if (server.hasArg(key)) {
        int np = server.arg(key).toInt();
        if (settings.pins[i] != np) { settings.pins[i] = np; pinsChanged = true; }
      }
    }
  }

  // Priority resolution: randomFade wins, then staticColor, then cycle
  if (settings.randomFadeEnabled) {
    settings.enStatColor     = false;
    settings.ledCycleEnabled = false;
  } else if (settings.ledCycleEnabled && settings.enStatColor) {
    settings.ledCycleEnabled = false; // static colour wins over cycle
  }

  // Reset fade state so it re-initialises with fresh RNG on next boot
  fadeState.initialised = false;

  state.isStaticColorSet = false;
  saveSettings();

  // Redirecting into a device that is about to reboot lands the browser on a
  // connection error. Hand back a page that waits for the node to answer again
  // and then goes home by itself — or, if the address is changing, says where
  // to find it.
  String here   = currentIP().toString();
  String target = settings.useStaticIP ? settings.staticIP : here;
  bool   moved  = (target != here);

  String c;
  c.reserve(2400);
  pageHead(c, settings.nodeName);
  c += F("<header class='masthead'><span class='dot'></span><div class='id'>"
         "<h1>Saved</h1><p class='readout'>");
  c += attrEscape(settings.nodeName);
  c += F("</p></div></header>"
         "<section class='panel'><div class='legend'>Restarting</div>"
         "<p class='foot' style='border-top:0'id='msg'>");
  if (moved) {
    c += F("The node is moving to <b class='mono'>");
    c += attrEscape(target);
    c += F("</b>. Open that address once the strips light up again.");
  } else {
    c += F("Waiting for the node to come back. This page reloads by itself.");
  }
  c += F("</p></section>");

  if (moved) {
    c += F("<div class='pagefoot'><a class='btn link' href='http://");
    c += attrEscape(target);
    c += F("/'>Open ");
    c += attrEscape(target);
    c += F("</a></div>");
  } else {
    // First probe waits out the reboot itself, then retries for about a minute.
    c += F("<script>var n=0;function p(){n++;fetch('/nodes',{cache:'no-store'})"
           ".then(function(){location.href='/'}).catch(function(){"
           "if(n<40)setTimeout(p,1500);else document.getElementById('msg').textContent="
           "'The node has not answered yet. Reload once it is back on the network.'})}"
           "setTimeout(p,4000)</script>");
  }
  c += F("</div></body></html>");

  server.send(200, "text/html", c);
  delay(500);
  ESP.restart();
}

// ─── OTA pages ────────────────────────────────────────────────────────────────
void handleOTAUpdate() {
  String c;
  c.reserve(1800);
  pageHead(c, settings.nodeName);
  c += F("<header class='masthead'><span class='dot'></span><div class='id'>"
         "<h1>Firmware update</h1><p class='readout'>");
  c += attrEscape(settings.nodeName);
  c += F("</p></div>"
         "<button type='button' id='theme' class='icon lg' aria-label='Switch theme'></button>"
         "</header>"
         "<form method='POST' action='/doUpdate' enctype='multipart/form-data'>"
         "<section class='panel'><div class='legend'>New firmware</div>");
  rowStart(c, F("Firmware file"),
           F("A .bin built for this board. Settings survive the update; the node "
             "restarts on its own when the upload finishes."),
           "fw");
  c += F("<input type='file' id='fw' name='update' accept='.bin'>");
  rowEnd(c);
  c += F("</section>"
         "<div class='dock'><p class='note'><b>Check the board first.</b> Firmware "
         "built for a different one will leave this node unbootable.</p>"
         "<input type='submit' class='btn go' value='Upload'></div></form>"
         "<div class='pagefoot'><a class='btn link' href='/'>Back to configuration</a></div>"
         "</div><script src='/app.js?v=" ASSET_VER "' defer></script></body></html>");
  server.send(200, "text/html", c);
}

void handleDoUpdate() {
  HTTPUpload& upload = server.upload();
  if (upload.status == UPLOAD_FILE_START) {
    Serial.printf("Update: %s\n", upload.filename.c_str());
    displayStatus("OTA Update", "Starting...");
    setStatusLED(120, 0, 120);
    if (!Update.begin(UPDATE_SIZE_UNKNOWN)) {
      Update.printError(Serial);
      setStatusLED(255, 0, 0);
    }
  } else if (upload.status == UPLOAD_FILE_WRITE) {
    if (Update.write(upload.buf, upload.currentSize) != upload.currentSize) {
      Update.printError(Serial);
      setStatusLED(255, 0, 0);
    } else {
      float p = (float)Update.progress() / (float)Update.size() * 100.0f;
      displayStatus("OTA Update", "Progress: " + String(p, 1) + "%");
    }
  } else if (upload.status == UPLOAD_FILE_END) {
    if (Update.end(true)) {
      displayStatus("OTA Update", "Complete!", "Rebooting...");
      setStatusLED(0, 255, 0);
    } else {
      Update.printError(Serial);
      setStatusLED(255, 0, 0);
    }
  }
  yield();
}

void handleOTAUpdateResponse() {
  bool failed = Update.hasError();

  String c;
  c.reserve(1400);
  pageHead(c, settings.nodeName);
  c += F("<header class='masthead'><span class='dot'></span><div class='id'><h1>");
  c += failed ? F("Update failed") : F("Update installed");
  c += F("</h1><p class='readout'>");
  c += attrEscape(settings.nodeName);
  c += F("</p></div></header><section class='panel'><p class='foot' "
         "style='border-top:0'>");
  c += failed ? F("The upload did not complete, so the node kept its current firmware. "
                  "Check the file and try again.")
              : F("Restarting on the new firmware. This page returns to the "
                  "configuration in a few seconds.");
  c += F("</p></section><div class='pagefoot'><a class='btn link' href='");
  c += failed ? F("/update'>Try again") : F("/'>Configuration");
  c += F("</a></div></div></body></html>");

  if (!failed) {
    server.sendHeader(F("Refresh"), F("6; url=/"));
  }
  server.send(200, "text/html", c);

  if (!failed) {
    delay(1000);
    ESP.restart();
  }
}
